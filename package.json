{
  "name": "dsh-minimal-bash-fix",
  "version": "0.1.0",
  "license": "MIT",
  "description": "DSH agent preset 分发包：修复极简模式（minimal）预设中 persistent bash 工具约 3.5s 延迟返回的完成检测 bug，并同步 minimal-fast preset 到 ~/.dsh/.agent-presets/minimal-fast。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "preset",
    "dsh-bashrc",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "agent-preset",
    "minimal"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sd1g1/dsh-minimal-bash-fix.git"
  },
  "bugs": {
    "url": "https://github.com/sd1g1/dsh-minimal-bash-fix/issues"
  },
  "homepage": "https://github.com/sd1g1/dsh-minimal-bash-fix#readme"
}
